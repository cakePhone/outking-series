<function name="stats_team_is_playing"
		window-func="false"
		returns-setof="false"
		behavior-type="CALLED ON NULL INPUT"
		function-type="VOLATILE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="1"
		row-amount="0">
	<schema name="public"/>
	<role name="postgres"/>
	<language name="plpgsql"/>
	<return-type>
	<type name="trigger" length="0"/>
	</return-type>
	<definition> <![CDATA[BEGIN
	IF NEW.id_team <> ALL (SELECT team_a, team_b FROM match WHERE id = NEW.id_match) THEN
	RAISE EXCEPTION 'stats team % does not belong to match %', NEW.id_team, NEW.id_match;
	END IF;
	RETURN NEW;
END;
]]> </definition>
</function>

