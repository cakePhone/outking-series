	</column>
	<column name="deleted_at" alias="Deletion Time">
		<type name="timestamptz" length="0"/>
	</column>
	<column name="reply_to" alias="Replying To" default-value="NULL">
		<type name="bigint" length="0"/>
	</column>
	<column name="updated_at" not-null="true" default-value="now()">
		<type name="timestamptz" length="0"/>
	</column>
	<constraint name="comment_pk" type="pk-constr" table="public.comment">
