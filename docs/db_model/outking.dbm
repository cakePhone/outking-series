<table name="team_member" layers="0" alias="Team Member" collapse-mode="2" max-obj-count="6" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="60" y="-400"/>
	<column name="id" alias="ID" not-null="true"
	 identity-type="ALWAYS" start="0" increment="1">
		<type name="bigint" length="0"/>
	</column>
	<column name="joined_at" alias="Join Time" not-null="true" default-value="now()">
		<type name="timestamptz" length="0"/>
	</column>
	<column name="left_at" alias="Leave Time" default-value="NULL">
		<type name="timestamptz" length="0"/>
	</column>
	<constraint name="team_member_pk" type="pk-constr" table="public.team_member">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="left_after_join" type="ck-constr" table="public.team_member">
			<expression> <![CDATA[left_at > joined_at]]> </expression>
