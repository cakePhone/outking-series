	</label>
</relationship>

<table name="match" layers="0" alias="Match" collapse-mode="1" max-obj-count="14" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="720" y="460"/>
	<column name="id" alias="ID" not-null="true"
	 identity-type="ALWAYS" start="0" increment="1">
		<type name="bigint" length="0"/>
	</column>
	<column name="state" alias="State" not-null="true" default-value="'pending'">
		<type name="public.match_state" length="0"/>
	</column>
	<column name="match_start" alias="Start">
		<type name="timestamptz" length="0"/>
	</column>
	<column name="match_end" alias="End">
		<type name="timestamptz" length="0"/>
	</column>
	<column name="points_a" alias="Points A">
		<type name="public.team_points" length="0"/>
	</column>
	<column name="points_b" alias="Points B">
		<type name="public.team_points" length="0"/>
	</column>
	<column name="team_a" alias="Team A">
		<type name="bigint" length="0"/>
		<comment> <![CDATA[If team is NULL, match is planned and team has yet to be decided.]]> </comment>
	</column>
	<column name="team_b" alias="Team B">
		<type name="bigint" length="0"/>
		<comment> <![CDATA[If team is NULL, match is planned and team has yet to be decided.]]> </comment>
	</column>
	<column name="match_result" alias="Result">
		<type name="public.match_result" length="0"/>
	</column>
	<column name="vod_url" alias="VOD URL">
		<type name="text" length="0"/>
	</column>
	<constraint name="match_pk" type="pk-constr" table="public.match">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="team_a_diff_team_b" type="ck-constr" alias="Team A &lt;&gt; Team B" table="public.match">
			<expression> <![CDATA[team_a <> team_b]]> </expression>
	</constraint>
	<constraint name="valid_match_winner" type="ck-constr" alias="Valid Match Winner" table="public.match">
			<expression> <![CDATA[(match_result = 'team_a_won') = (points_a.end_points > points_b.end_points)]]> </expression>
	</constraint>
	<constraint name="completed_means_end_exists" type="ck-constr" table="public.match">
			<expression> <![CDATA[state <> 'completed' OR match_end IS NOT NULL]]> </expression>
	</constraint>
	<constraint name="pending_state_match_end_null" type="ck-constr" table="public.match">
			<expression> <![CDATA[state <> 'pending' OR match_end IS NULL]]> </expression>
	</constraint>
	<constraint name="state_is_not_completed_or_match_is_valid" type="ck-constr" table="public.match">
			<expression> <![CDATA[state <> 'completed' OR (match_result IS NOT NULL AND points_a IS NOT NULL AND points_b IS NOT NULL)]]> </expression>
	</constraint>
	<constraint name="end_after_start" type="ck-constr" table="public.match">
			<expression> <![CDATA[match_end > match_start]]> </expression>
	</constraint>
	<constraint name="match_data_filled_after_completion" type="ck-constr" table="public.match">
			<expression> <![CDATA[state = 'completed' OR (match_result IS NULL AND points_a IS NULL AND points_b IS NULL)]]> </expression>
	</constraint>
	<constraint name="in_progress_match_started" type="ck-constr" table="public.match">
			<expression> <![CDATA[state <> 'in_progress' OR match_start IS NOT NULL]]> </expression>
	</constraint>

	<customidxs object-type="column">
		<object name="played_for_tournament" index="10"/>
	</customidxs>
	<customidxs object-type="constraint">
		<object name="tournament_fk" index="4"/>
	</customidxs></table>

<relationship name="tournament_has_many_match" type="rel1n" layers="0" alias="Tournament has Matches"
	 src-col-pattern="played_for_tournament"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 fk-idx-pattern="{st}_idx"
	 src-table="public.tournament"
	 dst-table="public.match"
	 src-required="false" dst-required="false">
	<label ref-type="name-label">
		<position x="0" y="0"/>
	</label>
</relationship>

<relationship name="team_enrollment" type="relnn" layers="0" alias="Teams enroll in Tournaments"
	 src-col-pattern="{sc}_{st}" dst-col-pattern="{sc}_{dt}"
	 pk-pattern="{gt}_pk" uq-pattern="{gt}_uq"
	 src-fk-pattern="{st}_fk" dst-fk-pattern="{dt}_fk"
	 pk-col-pattern="id"
	 fk-idx-pattern="{gt}_idx"
	 src-table="public.team"
	 dst-table="public.tournament"
	 src-required="false" dst-required="false"
	 table-name="team_enrollment"
	del-action="CASCADE">
	<label ref-type="name-label">
		<position x="76.1049" y="48.247"/>
	</label>
	<column name="enrolled_at" alias="Enrollment Time" not-null="true">
		<type name="timestamptz" length="0"/>
	</column>
	<column name="status" not-null="true" default-value="'pending'">
		<type name="public.enrollment_status" length="0"/>
	</column>
	<column name="rank_at_enrollment" not-null="true">
		<type name="bigint" length="0"/>
	</column>
	<constraint name="rank_not_below_0" type="ck-constr" table="public.team_enrollment">
			<expression> <![CDATA[rank_at_enrollment >= 0]]> </expression>
	</constraint>
</relationship>

<table name="match_player_stats" layers="0" alias="Match Player Stats" collapse-mode="1" max-obj-count="14" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="280" y="280"/>
	<column name="kills" alias="Kills" not-null="true">
		<type name="smallint" length="0"/>
	</column>
	<column name="deaths" alias="Deaths" not-null="true">
		<type name="smallint" length="0"/>
	</column>
	<column name="assists" alias="Assists" not-null="true">
		<type name="smallint" length="0"/>
	</column>
	<column name="hs_rate" alias="Headshot Rate" not-null="true">
		<type name="float" length="0"/>
	</column>
	<column name="first_bloods" alias="First Bloods" not-null="true">
		<type name="smallint" length="0"/>
	</column>
	<column name="clutches" alias="Clutches" not-null="true">
		<type name="smallint" length="0"/>
	</column>
	<column name="plants" alias="Plants" not-null="true">
		<type name="smallint" length="0"/>
	</column>
	<column name="defuses" alias="Defuses" not-null="true">
		<type name="smallint" length="0"/>
	</column>
	<column name="rank">
		<type name="smallint" length="0"/>
		<comment> <![CDATA[The player's rank when the match ocurred.]]> </comment>
	</column>
	<constraint name="hs_rate_check" type="ck-constr" alias="Headshot Rate within 0 and 1" table="public.match_player_stats">
			<expression> <![CDATA[hs_rate BETWEEN 0 AND 1]]> </expression>
	</constraint>

	<customidxs object-type="column">
		<object name="id_match" index="1"/>
		<object name="id_player" index="0"/>
		<object name="id_team" index="2"/>
	</customidxs>
	<customidxs object-type="constraint">
		<object name="match_fk" index="2"/>
		<object name="match_player_stats_pk" index="0"/>
		<object name="player_fk" index="1"/>
		<object name="team_fk" index="3"/>
	</customidxs></table>

