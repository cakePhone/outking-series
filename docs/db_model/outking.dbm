	</customidxs></table>

<relationship name="post_has_many_comment" type="rel1n" layers="0" alias="Post has Comments"
	 src-col-pattern="on_post"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
