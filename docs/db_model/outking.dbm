	</constraint>
</table>

<table name="tournament" layers="0" alias="Tournament" collapse-mode="1" max-obj-count="16" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="1080" y="860"/>
	<column name="id" alias="ID" not-null="true"
	 identity-type="ALWAYS" start="0" increment="1">
		<type name="bigint" length="0"/>
	</column>
	<column name="title" alias="Title" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="start_date" alias="Start Date" not-null="true" default-value="CURRENT_DATE">
		<type name="date" length="0"/>
	</column>
	<column name="end_date" alias="End Date" not-null="true">
		<type name="date" length="0"/>
	</column>
	<column name="min_teams" alias="Minimum Teams" not-null="true" default-value="2">
		<type name="smallint" length="0"/>
		<comment> <![CDATA[The amount of teams required for the tournament to start.]]> </comment>
	</column>
	<column name="max_teams" alias="Max Teams" not-null="true">
		<type name="smallint" length="0"/>
		<comment> <![CDATA[The maximum teams allowed to join the tournament]]> </comment>
	</column>
	<column name="qualifiers_end_date" alias="Qualifiers End" not-null="true">
		<type name="date" length="0"/>
	</column>
	<column name="group_stage_end_date" alias="Group Stage End" not-null="true">
		<type name="date" length="0"/>
	</column>
	<column name="play_off_end_date" alias="Play Offs End" not-null="true">
		<type name="date" length="0"/>
	</column>
	<column name="updated_at" alias="Last update" not-null="true" default-value="now()">
		<type name="timestamptz" length="0"/>
	</column>
	<column name="visible" alias="Visibility" not-null="true" default-value="false">
		<type name="boolean" length="0"/>
	</column>
	<column name="prize_pool" alias="Prize Pool">
		<type name="bigint" length="0"/>
	</column>
	<constraint name="tournament_pk" type="pk-constr" table="public.tournament">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="end_date_after_start_date" type="ck-constr" table="public.tournament">
			<expression> <![CDATA[end_date > start_date]]> </expression>
	</constraint>
	<constraint name="correct_stage_date_order" type="ck-constr" table="public.tournament">
			<expression> <![CDATA[qualifiers_end_date < group_stage_end_date AND group_stage_end_date < play_off_end_date]]> </expression>
	</constraint>
	<constraint name="two_min_teams" type="ck-constr" table="public.tournament">
			<expression> <![CDATA[min_teams >= 2]]> </expression>
	</constraint>
	<constraint name="max_teams_bigger_than_min" type="ck-constr" table="public.tournament">
			<expression> <![CDATA[max_teams >= min_teams]]> </expression>
	</constraint>
	<constraint name="qualifiers_cant_outlive_tournament" type="ck-constr" table="public.tournament">
			<expression> <![CDATA[qualifiers_end_date <= end_date]]> </expression>
		<comment> <![CDATA[This check also prevents all other stage end dates from outliving the tournament, as they must happen after qualifiers.]]> </comment>
	</constraint>

	<customidxs object-type="column">
		<object name="category" index="2"/>
		<object name="referenced_post" index="10"/>
	</customidxs>
	<customidxs object-type="constraint">
		<object name="post_fk" index="1"/>
		<object name="tournament_category_fk" index="3"/>
		<object name="tournament_uq" index="2"/>
	</customidxs></table>

