<table name="team" layers="0" alias="Team" collapse-mode="1" max-obj-count="9" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="940" y="-140"/>
	<column name="id" alias="ID" not-null="true"
	 identity-type="ALWAYS" start="0" increment="1">
		<type name="bigint" length="0"/>
	</column>
	<column name="name" alias="Name" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="tag" alias="Tag (Acronym)" not-null="true">
		<type name="char" length="3"/>
	</column>
	<column name="rank" alias="Rank" not-null="true" default-value="0">
		<type name="bigint" length="0"/>
	</column>
	<column name="created_at" alias="Created At" not-null="true" default-value="now()">
		<type name="timestamptz" length="0"/>
	</column>
	<column name="retired_at" alias="Retired At" default-value="NULL">
		<type name="timestamptz" length="0"/>
	</column>
	<column name="updated_at" not-null="true" default-value="now()">
		<type name="timestamptz" length="0"/>
	</column>
	<constraint name="team_pk" type="pk-constr" table="public.team">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="team_has_unique_acronym" type="uq-constr" alias="Team Tag is Unique" table="public.team">
		<columns names="tag" ref-type="src-columns"/>
	</constraint>
	<constraint name="retired_at_validity" type="ck-constr" alias="Retired At is Valid" table="public.team">
			<expression> <![CDATA[retired_at IS NULL OR retired_at >= created_at]]> </expression>
	</constraint>
	<constraint name="team_rank_not_below_zero" type="ck-constr" table="public.team">
			<expression> <![CDATA[rank >= 0]]> </expression>
	</constraint>

	<customidxs object-type="column">
		<object name="created_by" index="6"/>
	</customidxs>
	<customidxs object-type="constraint">
		<object name="player_fk" index="3"/>
	</customidxs></table>

<usertype name="player_role" configuration="enumeration">
	<schema name="public"/>
	<role name="postgres"/>
	<enumeration label="user"/>
	<enumeration label="moderator"/>
	<enumeration label="administrator"/>
</usertype>

<usertype name="match_result" configuration="enumeration">
	<schema name="public"/>
	<role name="postgres"/>
	<enumeration label="team_a_won"/>
	<enumeration label="team_b_won"/>
</usertype>

<usertype name="team_points" configuration="composite">
	<schema name="public"/>
	<role name="postgres"/>
	<comment> <![CDATA[A structure that holds per team points at the start and end of a match.]]> </comment>
	<typeattrib name="start_points">
		<type name="bigint" length="0"/>
	</typeattrib>
	<typeattrib name="end_points">
		<type name="bigint" length="0"/>
	</typeattrib>
</usertype>

<usertype name="match_state" configuration="enumeration">
	<schema name="public"/>
	<role name="postgres"/>
	<enumeration label="cancelled"/>
	<enumeration label="pending"/>
	<enumeration label="in_progress"/>
	<enumeration label="completed"/>
</usertype>

