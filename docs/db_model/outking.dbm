	<columns names="id,content,commented_at,deleted_at,commented_by,on_post,reply_to,updated_at"/>
</trigger>

<constraint name="unique_join_player_team_triple" type="uq-constr" table="public.team_member">
	<columns names="joined_at,id_player,id_team" ref-type="src-columns"/>
</constraint>

<relationship name="post_has_many_player_reports" type="rel1n" layers="0" alias="Reports link to Post"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 fk-idx-pattern="{st}_idx"
	 src-table="public.post"
	 dst-table="public.player_reports"
	 src-required="false" dst-required="false"/>

<relationship name="comment_has_many_player_reports" type="rel1n" layers="0" alias="Reports link to Comment"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 fk-idx-pattern="{st}_idx"
	 src-table="public.comment"
	 dst-table="public.player_reports"
	 src-required="false" dst-required="false"/>

<usertype name="enrollment_status" configuration="enumeration">
	<schema name="public"/>
	<role name="postgres"/>
	<enumeration label="pending"/>
	<enumeration label="rejected"/>
	<enumeration label="accepted"/>
</usertype>

<index name="unread_notif_idx" table="public.notification"
	 concurrent="false" unique="false" fast-update="false" buffering="false" nulls-not-distinct="false"
	 index-type="btree" factor="0">
		<idxelement use-sorting="false">
			<column name="recipient"/>
		</idxelement>
	<predicate> <![CDATA[read_at IS NULL]]> </predicate>
</index>

<index name="index_lower_tag_names" table="public.tag"
	 concurrent="false" unique="true" fast-update="false" buffering="false" nulls-not-distinct="false"
	 index-type="btree" factor="0">
		<idxelement use-sorting="false">
			<expression> <![CDATA[lower(name)]]> </expression>
		</idxelement>
</index>

<constraint name="reply_fk" type="fk-constr" alias="Reply FK" comparison-type="MATCH SIMPLE"
	 upd-action="NO ACTION" del-action="RESTRICT" ref-table="public.comment" table="public.comment">
	<columns names="reply_to" ref-type="src-columns"/>
	<columns names="id" ref-type="dst-columns"/>
</constraint>

<constraint name="team_a_fk" type="fk-constr" comparison-type="MATCH SIMPLE"
	 upd-action="NO ACTION" del-action="RESTRICT" ref-table="public.team" table="public.match">
	<columns names="team_a" ref-type="src-columns"/>
	<columns names="id" ref-type="dst-columns"/>
</constraint>

<constraint name="team_b_fk" type="fk-constr" comparison-type="MATCH SIMPLE"
	 upd-action="NO ACTION" del-action="RESTRICT" ref-table="public.team" table="public.match">
	<columns names="team_b" ref-type="src-columns"/>
	<columns names="id" ref-type="dst-columns"/>
</constraint>

<relationship name="rel_comment_comment" type="relfk" layers="0"
	 src-table="public.comment"
	 dst-table="public.comment" reference-fk="reply_fk"
	 src-required="false" dst-required="false">
	<line>
		<position x="-540.453" y="435.908"/>
	<position x="-540.453" y="327"/>
	<position x="-622.302" y="327"/>
	</line>
</relationship>

<relationship name="rel_match_team" type="relfk" layers="0"
	 src-table="public.match"
	 dst-table="public.team" reference-fk="team_a_fk"
	 src-required="false" dst-required="false"/>

<relationship name="rel_match_team1" type="relfk" layers="0"
	 src-table="public.match"
	 dst-table="public.team" reference-fk="team_b_fk"
	 src-required="false" dst-required="false"/>

</dbmodel>
